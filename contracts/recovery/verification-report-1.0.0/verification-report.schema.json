{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effexorwinpe.local/contracts/recovery/verification-report-1.0.0/verification-report.schema.json",
  "title": "Effexor Recovery verification report 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "verification_id",
    "case_id",
    "execution_id",
    "verifier",
    "verified_at",
    "expected_conditions",
    "observed_conditions",
    "status",
    "regressions",
    "remaining_risks",
    "evidence_refs"
  ],
  "properties": {
    "schema_name": { "const": "verification-report" },
    "schema_version": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/schemaVersion" },
    "verification_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/verificationId" },
    "case_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/caseId" },
    "execution_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/executionId" },
    "verifier": { "type": "string", "minLength": 1 },
    "verified_at": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/rfc3339" },
    "expected_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "observed_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "status": {
      "type": "string",
      "enum": ["resolved", "partially_resolved", "not_resolved", "regressed", "inconclusive"]
    },
    "regressions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remaining_risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/evidenceId" }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["met", "not_met", "unavailable"]
        },
        "detail": { "type": "string" }
      }
    }
  }
}

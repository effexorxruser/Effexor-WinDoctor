{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effexorwinpe.local/contracts/recovery/repair-approval-1.0.0/repair-approval.schema.json",
  "title": "Effexor Recovery repair-approval 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "approval_id",
    "case_id",
    "request_id",
    "plan_id",
    "plan_digest",
    "evaluation_id",
    "policy_digest",
    "source_commit_id",
    "technician_ref",
    "approved_at",
    "status",
    "acknowledged_risks",
    "scope_summary",
    "limitations"
  ],
  "properties": {
    "schema_name": { "const": "repair-approval" },
    "schema_version": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/schemaVersion" },
    "approval_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/repairApprovalId" },
    "case_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/caseId" },
    "request_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/approvalRequestId" },
    "plan_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/planId" },
    "plan_digest": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/sha256" },
    "evaluation_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/policyEvaluationId" },
    "policy_digest": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/sha256" },
    "source_commit_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/commitId" },
    "topology_id": {
      "type": "string",
      "pattern": "^$|^topology-[a-f0-9]{24}$"
    },
    "technician_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._@-]{0,127}$"
    },
    "approved_at": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/rfc3339" },
    "status": {
      "type": "string",
      "enum": ["approved", "rejected"]
    },
    "acknowledged_risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "scope_summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effexorwinpe.local/contracts/recovery/policy-evaluation-1.0.0/policy-evaluation.schema.json",
  "title": "Effexor Recovery policy-evaluation 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "evaluation_id",
    "case_id",
    "request_id",
    "plan_id",
    "plan_digest",
    "source_commit_id",
    "evaluated_at",
    "decision",
    "reason_codes",
    "policy_version",
    "limitations"
  ],
  "properties": {
    "schema_name": { "const": "policy-evaluation" },
    "schema_version": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/schemaVersion" },
    "evaluation_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/policyEvaluationId" },
    "case_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/caseId" },
    "request_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/policyRequestId" },
    "plan_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/planId" },
    "plan_digest": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/sha256" },
    "source_commit_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/commitId" },
    "topology_id": {
      "type": "string",
      "pattern": "^$|^topology-[a-f0-9]{24}$"
    },
    "evaluated_at": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/rfc3339" },
    "decision": {
      "type": "string",
      "enum": ["allowed", "denied", "needs_more_evidence"]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,127}$"
      },
      "uniqueItems": true
    },
    "policy_version": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/semver" },
    "input_digest": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/sha256" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effexorwinpe.local/contracts/recovery/repair-plan-1.0.0/repair-plan.schema.json",
  "title": "Effexor Recovery repair plan 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "plan_id",
    "case_id",
    "finding_refs",
    "steps",
    "risk_summary",
    "backup_requirements",
    "approval_requirements",
    "status"
  ],
  "properties": {
    "schema_name": { "const": "repair-plan" },
    "schema_version": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/schemaVersion" },
    "plan_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/planId" },
    "case_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/caseId" },
    "finding_refs": {
      "type": "array",
      "items": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/findingId" }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "operation_id",
          "operation_version",
          "target_id",
          "depends_on",
          "approval_required",
          "backup_required"
        ],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "operation_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/operationId" },
          "operation_version": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/semver" },
          "target_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/targetId" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "approval_required": { "type": "boolean" },
          "backup_required": { "type": "boolean" }
        }
      }
    },
    "risk_summary": { "type": "string", "minLength": 1 },
    "backup_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approval_requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "ready", "awaiting_approval", "approved", "rejected", "superseded", "cancelled"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effexorwinpe.local/contracts/recovery/store/snapshot-manifest-1.0.0/snapshot-manifest.schema.json",
  "title": "Effexor Recovery Case Store snapshot manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "case_id",
    "snapshot_id",
    "content_sha256",
    "created_at",
    "documents",
    "artifacts"
  ],
  "properties": {
    "schema_name": { "const": "snapshot-manifest" },
    "schema_version": { "const": "1.0.0" },
    "case_id": {
      "type": "string",
      "pattern": "^case-[a-f0-9]{24}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snapshot-[a-f0-9]{24}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256", "size_bytes", "media_type"],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "sha256",
          "size_bytes",
          "blob_relative_path",
          "kind",
          "media_classification"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^artifact-[a-f0-9]{24}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "blob_relative_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^artifacts/sha256/[a-f0-9]{2}/[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": ["log", "json", "binary", "screenshot", "report", "stdout", "stderr", "other"]
          },
          "media_classification": {
            "type": "string",
            "enum": ["case_local", "technician", "ephemeral", "export"]
          }
        }
      }
    }
  }
}

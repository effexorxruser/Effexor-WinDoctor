{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effexorwinpe.local/contracts/recovery/evidence-acquisition-record-1.0.0/evidence-acquisition-record.schema.json",
  "title": "Effexor Recovery evidence acquisition record 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "acquisition_id",
    "case_id",
    "request_id",
    "source_commit_id",
    "producer_type",
    "producer_id",
    "producer_version",
    "actor_type",
    "acquired_at",
    "target_ids",
    "input_evidence_ids",
    "added_target_ids",
    "added_evidence_ids",
    "parameters_sha256",
    "result_sha256",
    "limitations"
  ],
  "properties": {
    "schema_name": { "const": "evidence-acquisition-record" },
    "schema_version": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/schemaVersion" },
    "acquisition_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/acquisitionId" },
    "case_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/caseId" },
    "request_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/acquisitionRequestId" },
    "source_commit_id": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/commitId" },
    "producer_type": {
      "type": "string",
      "enum": ["target_resolver", "read_operation", "technician_selection"]
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
    },
    "producer_version": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/semver" },
    "actor_type": {
      "type": "string",
      "enum": ["system", "technician"]
    },
    "acquired_at": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/rfc3339" },
    "target_ids": {
      "type": "array",
      "items": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/targetId" },
      "uniqueItems": true
    },
    "input_evidence_ids": {
      "type": "array",
      "items": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/evidenceId" },
      "uniqueItems": true
    },
    "added_target_ids": {
      "type": "array",
      "items": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/targetId" },
      "uniqueItems": true
    },
    "added_evidence_ids": {
      "type": "array",
      "items": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/evidenceId" },
      "uniqueItems": true
    },
    "parameters_sha256": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/sha256" },
    "result_sha256": { "$ref": "https://effexorwinpe.local/contracts/recovery/common-1.0.0/common.schema.json#/$defs/sha256" },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "allOf": [
    {
      "anyOf": [
        { "properties": { "added_target_ids": { "type": "array", "minItems": 1 } } },
        { "properties": { "added_evidence_ids": { "type": "array", "minItems": 1 } } }
      ]
    }
  ]
}

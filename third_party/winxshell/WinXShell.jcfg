{
  "JS_DESKTOP": {
    "bkcolor": [32, 36, 44],
    "wallpaperstyle": 0,
    "wallpaper": ""
  },
  "JS_TASKBAR": {
    "smallicon": false,
    "userebar": false,
    "theme": "dark",
    "height": 40,
    "bkcolor": [0, 122, 204]
  },
  "JS_STARTMENU": {

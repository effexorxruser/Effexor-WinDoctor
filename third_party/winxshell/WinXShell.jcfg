      "reboot": {
        "command": "Wpeutil.exe",
        "parameters": "Reboot"
      },
      "shutdown": {
        "command": "Wpeutil.exe",
        "parameters": "Shutdown"
      }
    }
  },
  "JS_QUICKLAUNCH": {
    "maxiconsinrow": 8
  },
  "JS_NOTIFYAREA": {
  },
  "JS_NOTIFYCLOCK": {
  }
}
